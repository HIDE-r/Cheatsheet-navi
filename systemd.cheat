% systemd

;
; Power management
;

# [systemctl] [power] 重启
systemctl reboot

# [systemctl] [power] 关机
systemctl poweroff

# [systemctl] [power] 挂起
systemctl suspend

# [systemctl] [power] 休眠
systemctl hibernate

# [systemctl] [power] 休眠并挂起
systemctl hybrid-sleep

;
; Units
;

# [systemctl] [units] [list] 列出当前运行的units, systemctl不带参数时的默认行为
systemctl list-units

# [systemctl] [units] [list] 列出运行失败的units
systemctl --failed

# [systemctl] [units] [show] 查看unit运行状态, 若不指定unit, 默认为查看所有unit状态
systemctl status <units_or_pid>

# [systemctl] [units] [show] 列出units的帮助文档
systemctl help <units>

# [systemctl] [units] [show] 列出units的运行的属性值
systemctl show <units>

# [systemctl] [units] [show] 列出units的配置文件内容
systemctl cat <units>

# [systemctl] [units] [edit] override 方式编辑配置文件, 会创建 '.d/override.conf'
systemctl edit <units>

# [systemctl] [units] [check] 判断unit是否启用
systemctl is-enabled <units>

# [systemctl] [units] [check] 判断unit是否正在运行
systemctl is-active <units>

# [systemctl] [units] [check] 判断unit是否运行失败
systemctl is-failed <units>

# [systemctl] [units] 运行
systemctl start <units>

# [systemctl] [units] 停止
systemctl stop <units>

# [systemctl] [units] 重启
systemctl restart <units>

# [systemctl] [units] 重新加载配置文件
systemctl reload <units>

# [systemctl] [units] 禁止启动
systemctl mask <units>

# [systemctl] [units] 取消禁止启动
systemctl unmask <units>

# [systemctl] [units] 重载unit的改动到systemd
systemctl daemon-reload

;
; Target
;
# [systemctl] [target] get the default target
systemctl get-default

# [systemctl] [target] set the default target
systemctl set-default <target>

;
; Hostname
;

# [hostnamectl] 主机名和相关信息
hostnamectl

;
; Locale
;
# [localectl] 语言和键盘布局
localectl

;
; Time
;
# [timedatectl] 时间和时区
timedatectl

;
; Login
;
# [loginctl] 登录会话和用户信息
loginctl

;
; Network
;
# [networkctl] 网络接口和状态
networkctl

# [networkctl] 重启网络接口
sudo networkctl down <nic>; sudo networkctl up <nic>

$ nic: networkctl list --no-legend  | awk '{print $2}'

;
; DNS
;
# [resolvectl] DNS
resolvectl

;
; log
;
# [journalctl] kernel message from the current boot
journalctl -k

# [journalctl] 实时滚动
journalctl -f

# [journalctl] 查看指定unit的日志
journalctl -u <unit>

# [journalctl] 日志的磁盘占用情况
journalctl --disk-usage

;
; coredump
;
# [coredumpctl] coredump
coredumpctl

;
; systemd-analyze
;

# [systemd-analyze] 启动时间分析
systemd-analyze

# [systemd-analyze] 显示每个unit的详细启动时间
systemd-analyze blame

# [systemd-analyze] show configuration file and drop-ins
systemd-analyze cat-config <file>
